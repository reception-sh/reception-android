<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds talk to the local backend over plain HTTP (10.0.2.2 is the host machine from the emulator). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:usesCleartextTraffic="true"
        tools:ignore="UnusedAttribute">
        <!-- Exported in debug builds only, so verification can start it over the open chat with `adb shell am start`. -->
        <activity
            android:name=".SecondActivity"
            android:exported="true"
            tools:replace="android:exported" />
        <!-- Verification only: `adb shell am broadcast -n …/.VerificationReceiver -a …PUSH|…ROUTING` (see the class). -->
        <receiver
            android:name=".VerificationReceiver"
            android:exported="true"
            tools:ignore="ExportedReceiver">
            <intent-filter>
                <action android:name="sh.reception.receptionAndroidExample.PUSH" />
                <action android:name="sh.reception.receptionAndroidExample.ROUTING" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
