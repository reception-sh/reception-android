<?xml version="1.0" encoding="UTF-8"?>
<lint>
    <!-- Correctness problems that would reach host apps. -->
    <issue id="NewApi" severity="fatal" />
    <issue id="InlinedApi" severity="fatal" />
    <issue id="MissingTranslation" severity="fatal" />
    <issue id="ExtraTranslation" severity="fatal" />
    <issue id="StringFormatInvalid" severity="fatal" />
    <issue id="StringFormatCount" severity="fatal" />
    <issue id="StringFormatMatches" severity="fatal" />
    <issue id="MissingQuantity" severity="fatal" />
    <issue id="UnusedQuantity" severity="fatal" />
    <issue id="ImpliedQuantity" severity="fatal" />
    <issue id="PluralsCandidate" severity="fatal" />
    <issue id="WrongThread" severity="fatal" />
    <issue id="MissingPermission" severity="fatal" />
    <issue id="UnspecifiedRegisterReceiverFlag" severity="fatal" />
    <issue id="UnspecifiedImmutableFlag" severity="fatal" />
    <issue id="HardcodedText" severity="fatal" />
    <issue id="SetTextI18n" severity="fatal" />
    <issue id="RtlHardcoded" severity="fatal" />
    <issue id="PrivateResource" severity="fatal" />
    <issue id="ComposableNaming" severity="fatal" />
    <issue id="ModifierParameter" severity="fatal" />
    <!-- Dependency versions are fixed in SPEC.md for host compatibility; newer releases are not wanted. -->
    <issue id="GradleDependency" severity="ignore" />
    <issue id="NewerVersionAvailable" severity="ignore" />
    <issue id="AndroidGradlePluginVersion" severity="ignore" />
    <!-- Strings are generated from the iOS String Catalog, whose translations are reviewed there. -->
    <issue id="Typos" severity="ignore" />
    <!-- SPEC.md ships Hebrew and Indonesian twice: iw/in for the Java codes and b+he/b+id for Android 14+, which
         keeps the modern codes. Lint only knows the legacy rule. -->
    <issue id="LocaleFolder" severity="ignore" />
    <!-- Splitting by language is the host's bundle configuration; SPEC.md's languageOverride needs the host to keep
         the SDK's languages in its base APK (see STATUS.md). -->
    <issue id="AppBundleLocaleChanges" severity="ignore" />
</lint>
